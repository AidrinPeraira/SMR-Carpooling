model JourneyPassenger {
  journeyPassengerId String @id @default(uuid())

  passengerId   String
  passenger     Passenger @relation(fields: [passengerId], references: [passengerId])
  passengerName String

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [journeyId])

  bookingId String   @unique
  booking   Bookings @relation(fields: [bookingId], references: [bookingId])

  passengerStatus PassengerRideStatus @default(waiting)

  pickupLocation  Json
  dropOffLocation Json

  pickupOTP      String?
  pickupTime     DateTime?
  dropoffTime    DateTime?
  pickupVerified Boolean   @default(false)

  //index to list all passengers of a journey
  @@index([journeyId])
}
