enum PassengerRideStatus {
  waiting
  picked_up
  no_show
  droopped_off
}

model Journey {
  // matches the tripId of the trip being tracked
  journeyId String @id
  trip      Trip   @relation(fields: [journeyId], references: [tripId])

  driverId String
  driver   Driver @relation(fields: [driverId], references: [driverId])

  origin      Json
  destination Json

  intermediateStops Json

  journeyStatus TripStatus @default(ongoing)

  createdAt DateTime
  updatedAt DateTime

  journeyPassengers JourneyPassenger[]

  @@index([driverId, journeyStatus])
}
