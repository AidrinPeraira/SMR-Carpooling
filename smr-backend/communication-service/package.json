{
  "name": "@smr/communication-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "imports": {
    "#/*": {
      "production": "./dist/src/*.js",
      "default": "./src/*"
    },
    "&#/*": "./tests/*"
  },
  "scripts": {
    "dev": "tsx watch  --import ./src/instrumentation.ts src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "docker:build": "docker build --target communication-service-prod -t aidrinperaira/communication-service:latest -f ../../Dockerfile.prod ../..",
    "docker:push": "docker push aidrinperaira/communication-service:latest",
    "docker:publish": "pnpm run docker:build && pnpm run docker:push",
    "update:shared": "pnpm add @sharemyride/shared@latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@sharemyride/shared": "^0.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.11.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/host-metrics": "^0.39.0",
    "@opentelemetry/instrumentation-host-metrics": "^0.5.0",
    "@opentelemetry/instrumentation-winston": "^0.66.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@opentelemetry/winston-transport": "^0.32.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "amqplib": "^2.0.1",
    "mongoose": "^9.6.2",
    "tsx": "^4.19.2",
    "winston": "^3.19.0",
    "typescript": "^5.7.2"
  }
}
