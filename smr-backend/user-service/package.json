{
  "name": "@smr/user-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "imports": {
    "#/*": {
      "production": "./dist/src/*.js",
      "default": "./src/*"
    },
    "&#/*": "./tests/*"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build --target user-service-prod -t aidrinperaira/user-service:latest -f ../../Dockerfile.prod ../..",
    "docker:push": "docker push aidrinperaira/user-service:latest",
    "docker:publish": "pnpm run docker:build && pnpm run docker:push",
    "update:shared": "pnpm add @sharemyride/shared@latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@sharemyride/shared": "^0.0.3",
    "add": "^2.0.6",
    "amqplib": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "morgan": "^1.11.0",
    "redis": "^6.0.0",
    "zod": "^4.4.3"
  }
}
