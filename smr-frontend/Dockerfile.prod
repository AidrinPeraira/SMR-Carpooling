# syntax=docker/dockerfile:1
FROM node:24-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS build
COPY . /usr/src/app
WORKDIR /usr/src/app

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# Build the specific service
RUN pnpm --filter=@smr/frontend build

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

# Next.js standalone mode output
COPY --from=build /usr/src/app/smr-frontend/.next/standalone ./
COPY --from=build /usr/src/app/smr-frontend/.next/static ./smr-frontend/.next/static
COPY --from=build /usr/src/app/smr-frontend/public ./smr-frontend/public

EXPOSE 3000

# In standalone mode, Next.js provides a server.js file
CMD ["node", "smr-frontend/server.js"]
