# syntax=docker/dockerfile:1
FROM node:24-slim AS base
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

FROM base AS api-gateway-builder
WORKDIR /app
COPY tsconfig.base.json ./
WORKDIR /app/smr-backend/api-gateway
COPY ./smr-backend/api-gateway/package.json ./smr-backend/api-gateway/tsconfig.json ./

RUN --mount=type=cache,target=/root/.npm npm install
RUN --mount=type=cache,target=/root/.npm npm install --save-dev typescript @types/node @types/express @types/cors @types/jsonwebtoken @types/morgan

COPY ./smr-backend/api-gateway/src ./src
RUN npm run build -- --noEmit false

FROM base AS api-gateway-prod
USER node
WORKDIR /app
ENV NODE_ENV=production
COPY --chown=node:node ./smr-backend/api-gateway/package.json ./package.json
RUN --mount=type=cache,target=/home/node/.npm,uid=1000,gid=1000 npm install --omit=dev
COPY --chown=node:node --from=api-gateway-builder /app/smr-backend/api-gateway/dist/ ./dist
EXPOSE 4000
CMD ["node", "--conditions", "production", "dist/src/index.js"]



# --- 2. User Service ---
FROM base AS user-service-builder
WORKDIR /app
COPY tsconfig.base.json ./
WORKDIR /app/smr-backend/user-service
COPY ./smr-backend/user-service/package.json ./smr-backend/user-service/tsconfig.json ./
RUN --mount=type=cache,target=/root/.npm npm install
RUN --mount=type=cache,target=/root/.npm npm install --save-dev typescript @types/node @types/express @types/cors @types/jsonwebtoken @types/morgan @types/amqplib
COPY ./smr-backend/user-service/src ./src
RUN npm run build -- --noEmit false

FROM base AS user-service-prod
USER node
WORKDIR /app
ENV NODE_ENV=production
COPY --chown=node:node ./smr-backend/user-service/package.json ./package.json
RUN --mount=type=cache,target=/home/node/.npm,uid=1000,gid=1000 npm install --omit=dev
COPY --chown=node:node --from=user-service-builder /app/smr-backend/user-service/dist/ ./dist
EXPOSE 4001
CMD ["node", "--conditions", "production", "dist/src/index.js"]

# --- 3. Notification Service ---
