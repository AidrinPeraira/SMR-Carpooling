# syntax=docker/dockerfile:1
FROM node:24-slim AS base
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable 

# Build the dist folder for each service
FROM base AS builder

WORKDIR /app

COPY ./package.json ./tsconfig.base.json ./pnpm-lock.yaml ./pnpm-workspace.yaml ./

COPY ./smr-backend/user-service/package.json ./smr-backend/user-service/
COPY ./smr-backend/trip-service/package.json ./smr-backend/trip-service/
COPY ./smr-backend/realtime-service/package.json ./smr-backend/realtime-service/
COPY ./smr-backend/payment-service/package.json ./smr-backend/payment-service/
COPY ./smr-backend/notification-service/package.json ./smr-backend/notification-service/
COPY ./smr-backend/mcp-service/package.json ./smr-backend/mcp-service/
COPY ./smr-backend/api-gateway/package.json ./smr-backend/api-gateway/

COPY ./smr-shared/package.json ./smr-shared/ 

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm install --fetch-timeout 600000 --frozen-lockfile

COPY ./smr-backend/ ./smr-backend/
COPY ./smr-shared/ ./smr-shared/ 

RUN pnpm -F @sharemyride/shared run build
RUN pnpm -F @smr/trip-service run prisma:generate
RUN pnpm run build
RUN find smr-backend/*/dist -name '*.js' \
    -exec sed -i -E "s/from (['\"])(\\.\\.?\\/[^'\"]+)\\1/from \\1\\2.js\\1/g" {} +

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm -F @smr/user-service --prod deploy /prod/user-service --legacy --fetch-timeout 600000
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm -F @smr/trip-service --prod deploy /prod/trip-service --legacy --fetch-timeout 600000
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm -F @smr/realtime-service --prod deploy /prod/realtime-service --legacy --fetch-timeout 600000
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm -F @smr/payment-service --prod deploy /prod/payment-service --legacy --fetch-timeout 600000
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm -F @smr/notification-service --prod deploy /prod/notification-service --legacy --fetch-timeout 600000
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm -F @smr/mcp-service --prod deploy /prod/mcp-service --legacy --fetch-timeout 600000
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm -F @smr/api-gateway --prod deploy /prod/api-gateway --legacy --fetch-timeout 600000
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm -F @sharemyride/shared --prod deploy /prod/shared --legacy --fetch-timeout 600000

# build the production image
FROM base AS smr-api-gateway
USER node
WORKDIR /app

COPY --chown=node:node --from=builder /app/smr-backend/api-gateway/package.json ./
COPY --chown=node:node --from=builder /prod/api-gateway/node_modules ./node_modules/
COPY --chown=node:node --from=builder /prod/shared ./node_modules/@sharemyride/shared/
COPY --chown=node:node --from=builder /app/smr-shared/dist ./node_modules/@sharemyride/shared/dist/
COPY --chown=node:node --from=builder /app/smr-backend/api-gateway/dist ./dist/

CMD [ "node" , "--conditions" , "production" , "--import" , "./dist/src/instrumentation.js" , "dist/src/index.js" ]

