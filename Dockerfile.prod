# --- 4. Trip Service ---
FROM base AS trip-service-builder
WORKDIR /app
COPY tsconfig.base.json ./
WORKDIR /app/smr-backend/trip-service
COPY ./smr-backend/trip-service/package.json ./smr-backend/trip-service/tsconfig.json ./smr-backend/trip-service/prisma.config.ts ./
RUN --mount=type=cache,target=/root/.npm npm install
RUN --mount=type=cache,target=/root/.npm npm install --save-dev prisma typescript @types/node @types/express @types/cors @types/jsonwebtoken @types/morgan @types/amqplib
COPY ./smr-backend/trip-service/src ./src
RUN npm run prisma:generate
RUN npm run build -- --noEmit false
RUN mkdir -p ./dist/src/infrastructure/database/generated && cp -r ./src/infrastructure/database/generated/* ./dist/src/infrastructure/database/generated/

FROM base AS trip-service-prod
USER node
WORKDIR /app
ENV NODE_ENV=production
COPY --chown=node:node ./smr-backend/trip-service/package.json ./package.json
RUN --mount=type=cache,target=/home/node/.npm,uid=1000,gid=1000 npm install --omit=dev
COPY --chown=node:node --from=trip-service-builder /app/smr-backend/trip-service/dist/ ./dist
EXPOSE 4003
CMD ["node", "--conditions", "production", "dist/src/index.js"]

