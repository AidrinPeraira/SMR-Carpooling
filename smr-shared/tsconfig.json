{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "ignoreDeprecations": "6.0",
    "types": []
    },  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
